# Leave VITE_API_URL BLANK for web deployments. The app then calls the same
# origin under its base path (e.g. https://host/account/api), which is what the
# nginx-proxied web build needs. Only cross-origin builds (the Android APK) set
# it — see .env.android.
VITE_API_URL=

# Deployment base path (web builds only). Defaults to /account/. Override at
# build time to deploy under any prefix WITHOUT changing source, e.g.:
#   BASE_PATH=/          npm run build   # root
#   BASE_PATH=/school/   npm run build   # /school
# (Set via the BASE_PATH env var, not this file — shown here for reference.)

# Base URL used to build customer-facing "share invoice" links (WhatsApp).
# On the web this defaults to the current origin and can stay blank.
VITE_PUBLIC_WEB_URL=
