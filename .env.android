# ─────────────────────────────────────────────────────────────────────────────
# Android / Capacitor build configuration — loaded only for `--mode android`
# (the android:* npm scripts). The APK is served from the device root
# (https://localhost/), so it CANNOT use same-origin "/api" and MUST point at a
# public HTTPS backend baked in at build time.
#
# Replace the value below with your deployed backend URL, then rebuild:
#   npm run android:apk    (see README-android.md)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://nexussoftlab.com/account

# The Android app's origin (https://localhost) is not customer-openable, so
# share links must use the deployed web app URL.
VITE_PUBLIC_WEB_URL=https://nexussoftlab.com/account
